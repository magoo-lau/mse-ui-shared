# 统一换行策略：脚本类文件仓库内恒为 LF（Windows core.autocrlf=true 检出也不转换），
# 否则 sh 脚本带 CRLF 在 Linux CI 上无法执行
*.sh    text eol=lf
*.mjs   text eol=lf
Jenkinsfile text eol=lf
*.yml   text
*.yaml  text
*.xml   text
*.java  text
*.sql   text
*.md    text
# Windows 专用脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
